left_join(data.movies %>%
select(movieId, title, main.genre),
join_by(movieId))
head(ratings)
ratings$title[which.max(ratings$avg.rating)]
ratings$title[which.min(ratings$avg.rating)]
ratings$title[which.min(ratings$sd.rating)]
Miyazaki.indices = grep("Totoro|Mononoke|Spirited", ratings$title)
mean(ratings$avg.rating[Miyazaki.indices])
